# Keys
API_KEY=long-random-string
ENCRYPTION_KEY=generate-with-fernet

# Database
DATABASE_URL=postgresql+asyncpg://mailservice:mailservice@localhost:5432/mailservice
DATABASE_URL_SYNC=postgresql+psycopg2://mailservice:mailservice@localhost:5432/mailservice

# Docker Mailserver
MAILSERVER_CONTAINER=mailserver
IMAP_HOST=mail.host.com
IMAP_PORT=993